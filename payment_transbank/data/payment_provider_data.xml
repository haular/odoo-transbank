<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="payment_provider_transbank" model="payment.provider">
        <field name="name">Transbank</field>
        <field name="code">transbank</field>
        <field name="redirect_form_view_id" ref="payment_transbank.redirect_form"/>
        <field name="image_128" type="base64" file="payment_transbank/static/description/icon.svg"/>
        <field name="is_published">True</field>
        <field name="payment_method_ids" eval="[
            Command.link(ref('payment_transbank.payment_method_webpay')),
            Command.link(ref('payment_transbank.payment_method_oneclick')),
        ]"/>
    </record>
</odoo>

