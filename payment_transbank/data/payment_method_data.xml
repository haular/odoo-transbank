<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_method_webpay" model="payment.method">
        <field name="name">Webpay Plus</field>
        <field name="code">webpay</field>
        <field name="image" type="base64" file="payment_transbank/static/img/webpay.png"/>

        <field name="is_primary">True</field>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_refund">partial</field>
<!--        <field name="supported_country_ids" eval="[Command.link(ref('base.cl'))]"/>-->
<!--        <field name="supported_currency_ids" eval="[Command.link(ref('base.CLP'))]"/>-->
        <field name="active">True</field>
    </record>

    <record id="payment_method_oneclick" model="payment.method">
        <field name="name">Oneclick</field>
        <field name="code">oneclick</field>
        <field name="image" type="base64" file="payment_transbank/static/img/oneclick.png"/>
        <field name="is_primary">True</field>
        <field name="support_tokenization">True</field>
        <field name="support_express_checkout">False</field>
        <field name="support_refund">partial</field>
<!--        <field name="supported_country_ids" eval="[Command.link(ref('base.cl'))]"/>-->
<!--        <field name="supported_currency_ids" eval="[Command.link(ref('base.CLP'))]"/>-->
        <field name="active">True</field>
    </record>
</odoo>