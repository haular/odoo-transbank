<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_view_form_transbank" model="ir.ui.view">
        <field name="name">payment.provider.form.transbank</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="inside">
                <group invisible="code != 'transbank'">
                    <!-- Fields will be added by sub-modules (webpay, oneclick) -->
                    <div colspan="2" class="alert alert-info" invisible="state != 'test'" role="status">
                        <strong>Credentials are not required when Test Mode is active.</strong>
                        <br/>
                        The SDK already includes test environment credentials for integration.
                        <br/>
                        <br/>
                        Transbank Test Resources:<br/>
                        <a href="https://transbankdevelopers.cl/documentacion/como_empezar#tarjetas-de-prueba"
                           target="_blank">Test Cards
                        </a>
                        |
                        <a href="https://www.transbankdevelopers.cl/documentacion/como_empezar#codigos-de-comercio"
                           target="_blank">Merchant codes
                        </a>
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
