<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="payment_provider_view_form_transbank" model="ir.ui.view">
        <field name="name">payment.provider.form.transbank</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="inside">
                <div colspan="2" class="alert alert-info" invisible="code != 'transbank' or is_live" role="status">
                    <strong>Test mode:</strong> payments go to Transbank's integration environment. If the
                    credentials below are empty, Transbank's public integration credentials are used.
                    <br/>
                    Test cards and integration commerce codes:
                    <br/>
                    <a
                            href="https://transbankdevelopers.cl/documentacion/como_empezar#tarjetas-de-prueba"
                            target="_blank"
                    >
                        Transbank Test Cards
                    </a>
                    <br/>
                    <a
                            href="https://www.transbankdevelopers.cl/documentacion/como_empezar#codigos-de-comercio"
                            target="_blank"
                    >
                        Transbank Merchant code
                    </a>
                </div>
                <group name="transbank_credentials_group" invisible="code != 'transbank'">
                    <!-- Fields will be added by sub-modules (webpay, oneclick) -->

                </group>
            </xpath>
        </field>
    </record>
</odoo>
