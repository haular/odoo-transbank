<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_view_form_transbank" model="ir.ui.view">
        <field name="name">payment.provider.form.transbank</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="inside">
                <group invisible="code != 'transbank'">
                    <separator string="Webpay Plus Credentials" colspan="2"/>
                    <field name="transbank_commerce_code" required="code == 'transbank' and state == 'enabled'"/>
                    <field name="transbank_api_key" password="True" required="code == 'transbank' and state == 'enabled'"/>
                    
                    <separator string="Oneclick Mall Credentials" colspan="2"/>
                    <field name="transbank_oneclick_commerce_code" required="code == 'transbank' and state == 'enabled'"/>
                    <field name="transbank_oneclick_api_key" password="True" required="code == 'transbank' and state == 'enabled'"/>
                    
                    <div colspan="2" class="alert alert-info" invisible="state != 'test'" role="status">
                        <strong>Credentials are not required when Test Mode is active.</strong>
                        <br/>
                        The SDK already includes test environment credentials, which will be used automatically while this mode is selected.
                        <br/><br/>
                        Furthermore, when you access the Transbank website and need to enter a test card, you can use the cards available at the following link:
                        <a href="https://transbankdevelopers.cl/documentacion/como_empezar#tarjetas-de-prueba" target="_blank">Transbank Test Cards</a>
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>